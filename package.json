{
  "name": "occ-sandbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings && pnpm lint:next",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:next": "eslint . --max-warnings 0",
    "lint:fix": "biome lint --write . && eslint . --fix",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false --error-on-warnings .",
    "check": "biome check . --error-on-warnings && pnpm lint:next && pnpm typecheck"
  },
  "dependencies": {
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
